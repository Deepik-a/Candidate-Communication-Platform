SECRET_KEY=django-insecure-dev-key-change-in-production-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: 'sqlite3' (zero setup, local dev) or set DATABASE_URL for PostgreSQL
DB_ENGINE=sqlite3

# ── Dummy Communication Provider ──────────────────────────────────────────────
# The dummy provider is a standalone HTTP service (dummy_provider/server.py).
# Start it with: python dummy_provider/server.py
# It simulates: send, status updates (webhooks), success, failure, temporary outages.
DEFAULT_COMMUNICATION_PROVIDER=dummy
DUMMY_PROVIDER_URL=http://localhost:9000

# Webhook URL the dummy provider uses to call back into this backend
WEBHOOK_URL=http://localhost:8000/api/v1/communications/webhook/

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=False
