SECRET_KEY=django-insecure-dev-key-change-in-production-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: 'sqlite3' (zero setup, development) or 'postgresql' (production)
DB_ENGINE=sqlite3
DB_NAME=candidate_comm_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOW_ALL_ORIGINS=True

# ── Communication Providers ──────────────────────────────────────────────────
# Default provider: 'dummy' (standalone service on port 9000), 'whatsapp' (real Meta Cloud API / Sandbox), or 'mock'
DEFAULT_COMMUNICATION_PROVIDER=dummy
DUMMY_PROVIDER_URL=http://localhost:9000

# Meta WhatsApp Cloud API credentials (for live integration)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
